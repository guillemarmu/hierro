rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Datos privados de cada usuario (entrenos, rutinas, medidas): solo su dueño
    match /users/{uid}/{document=**} {
      allow read, write: if signed() && me() == uid;
    }

    // Perfil público: lo ve cualquiera con cuenta, solo lo cambia su dueño
    match /profiles/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid && request.resource.data.uid == uid;
      allow delete: if signed() && me() == uid;
    }

    // Nombres de usuario únicos
    match /usernames/{name} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me() && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signed() && resource.data.uid == me();
    }

    // Seguir: el id es "quien_a quien"
    match /follows/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.from == me() && id == me() + '_' + request.resource.data.to;
      allow update: if signed() && resource.data.from == me() && request.resource.data.from == me() && request.resource.data.to == resource.data.to;
      allow delete: if signed() && (resource.data.from == me() || resource.data.to == me());
    }

    // Entrenos publicados en el feed
    match /posts/{pid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow delete: if signed() && resource.data.uid == me();
      // El dueño lo edita; los demás solo pueden darse/quitarse su propio me gusta y sumar/restar un comentario
      allow update: if signed() && (
        (resource.data.uid == me() && request.resource.data.uid == me())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
            && request.resource.data.get('likes', []).toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([me()])
            && resource.data.get('likes', []).toSet().difference(request.resource.data.get('likes', []).toSet()).hasOnly([me()])
            && (request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0)) in [-1, 0, 1]));

      match /comments/{cid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.uid == me()
                      && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if signed() && (resource.data.uid == me() || get(/databases/$(database)/documents/posts/$(pid)).data.uid == me());
      }
    }

    // Notificaciones: las escribe quien actúa, solo las lee su destinatario
    match /notifs/{uid}/items/{nid} {
      allow read, delete: if signed() && me() == uid;
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && resource.data.from == me() && request.resource.data.from == me();
    }
  }
}
