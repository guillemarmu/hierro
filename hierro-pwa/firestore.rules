rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Datos privados de cada usuario (entrenos, rutinas, medidas): solo su dueño
    match /users/{uid}/{document=**} {
      allow read, write: if signed() && me() == uid;
    }

    // Perfil público: lo ve cualquiera con cuenta, solo lo cambia su dueño
    match /profiles/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid && request.resource.data.uid == uid;
      allow delete: if signed() && me() == uid;
    }

    // Nombres de usuario únicos
    match /usernames/{name} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me() && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signed() && resource.data.uid == me();
    }

    // Seguir: el id es "quien_a quien"
    match /follows/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.from == me() && id == me() + '_' + request.resource.data.to;
      allow update: if signed() && resource.data.from == me() && request.resource.data.from == me() && request.resource.data.to == resource.data.to;
      allow delete: if signed() && (resource.data.from == me() || resource.data.to == me());
    }

    // Entrenos publicados en el feed
    match /posts/{pid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow delete: if signed() && resource.data.uid == me();
      // El dueño lo edita; los demás solo pueden darse/quitarse su propio me gusta y sumar/restar un comentario
      allow update: if signed() && (
        (resource.data.uid == me() && request.resource.data.uid == me())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
            && request.resource.data.get('likes', []).toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([me()])
            && resource.data.get('likes', []).toSet().difference(request.resource.data.get('likes', []).toSet()).hasOnly([me()])
            && (request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0)) in [-1, 0, 1]));

      match /comments/{cid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.uid == me()
                      && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if signed() && (resource.data.uid == me() || get(/databases/$(database)/documents/posts/$(pid)).data.uid == me());
      }
    }

    // Notificaciones: las escribe quien actúa, solo las lee su destinatario
    match /notifs/{uid}/items/{nid} {
      allow read, delete: if signed() && me() == uid;
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && resource.data.from == me() && request.resource.data.from == me();
    }

    // Clanes: los ve cualquiera con cuenta. El jefe (owner) lo edita, expulsa y lo borra;
    // los demás solo pueden meterse o sacarse a sí mismos de la lista de miembros (máximo 30).
    function validClan(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 24
        && d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 8
        && d.desc is string && d.desc.size() <= 120
        && d.owner is string
        && d.members is list && d.members.size() <= 30
        && d.get('kicked', []) is list && d.get('kicked', []).size() <= 100;
    }
    match /clans/{cid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == me() && request.resource.data.members == [me()]
                    && request.resource.data.keys().hasOnly(['name', 'emoji', 'desc', 'owner', 'members', 'created'])
                    && validClan(request.resource.data);
      allow update: if signed() && validClan(request.resource.data) && (
        // el jefe: cambia nombre, emblema y descripción, expulsa (no puede meter a nadie) y puede pasar el mando a otro miembro
        (resource.data.owner == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'desc', 'members', 'owner', 'kicked'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.owner in request.resource.data.members)
        // cualquier otro: solo entrar o salir él mismo (y no puede volver si le expulsaron)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([me()])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([me()])
          && (!(me() in request.resource.data.members) || !(me() in resource.data.get('kicked', [])))));
      allow delete: if signed() && resource.data.owner == me();
    }

    // Resumen público de la liga (puntos por semana, racha, logros y, si la persona lo activa, el cociente de fuerza relativa).
    // Solo lo escribe su dueño y solo con estos campos: no hay sitio para el peso corporal ni para otros datos privados.
    match /scores/{uid} {
      allow read: if signed();
      allow create, update: if signed() && me() == uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'uid', 'name', 'username', 'clan', 'wk', 'weeks', 'months', 'streak', 'lastWk', 'ach', 'rel', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.clan is string && request.resource.data.clan.size() <= 40
        && request.resource.data.updated is int
        && request.resource.data.weeks is map && request.resource.data.weeks.size() <= 10
        && request.resource.data.ach is list && request.resource.data.ach.size() <= 60
        && (!('months' in request.resource.data) || (request.resource.data.months is map && request.resource.data.months.size() <= 14))
        && (!('rel' in request.resource.data) || (request.resource.data.rel is map && request.resource.data.rel.size() <= 6));
      allow delete: if signed() && me() == uid;
    }

    // ---------- Relaciones entre clanes: alianzas y piques ----------
    function clanOwner(cid) { return get(/databases/$(database)/documents/clans/$(cid)).data.owner; }
    function pairId(x, y) { return x < y ? x + '_' + y : y + '_' + x; }
    function relListOf(t) { return t == 'alianza' ? 'allies' : 'rivals'; }
    function inLinks(cid, other, t) { return other in getAfter(/databases/$(database)/documents/clanrels/$(cid)).data.get(relListOf(t), []); }

    // relations/{a_b}: a < b (ids de clan). Un solo documento por pareja: o aliados o rivales.
    // Propone el jefe del clan «from»; acepta solo el jefe del otro; cualquiera de los dos jefes rechaza o termina.
    match /relations/{rid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['a', 'b', 'type', 'status', 'from', 'by', 'created', 'msg'])
        && request.resource.data.a is string && request.resource.data.b is string
        && request.resource.data.a < request.resource.data.b
        && rid == request.resource.data.a + '_' + request.resource.data.b
        && request.resource.data.type in ['alianza', 'pique']
        && request.resource.data.status == 'pendiente'
        && request.resource.data.from in [request.resource.data.a, request.resource.data.b]
        && request.resource.data.by == me()
        && clanOwner(request.resource.data.from) == me()
        && exists(/databases/$(database)/documents/clans/$(request.resource.data.from == request.resource.data.a ? request.resource.data.b : request.resource.data.a))
        && request.resource.data.created is int
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() <= 120));
      // aceptar: solo pasa a «activa» si a la vez entra en las listas de los dos clanes (que tienen como mucho 5)
      allow update: if signed()
        && resource.data.status == 'pendiente' && request.resource.data.status == 'activa'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted'])
        && request.resource.data.accepted is int
        && clanOwner(resource.data.from == resource.data.a ? resource.data.b : resource.data.a) == me()
        && inLinks(resource.data.a, resource.data.b, resource.data.type)
        && inLinks(resource.data.b, resource.data.a, resource.data.type);
      allow delete: if signed() && (clanOwner(resource.data.a) == me() || clanOwner(resource.data.b) == me());

      // Muro de piques: lo leen todos; escriben los miembros de los dos clanes; borra el autor o cualquiera de los dos jefes
      match /msgs/{mid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'clan', 'text', 'ts'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 140
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.ts is int
          && get(/databases/$(database)/documents/relations/$(rid)).data.status == 'activa'
          && request.resource.data.clan in [get(/databases/$(database)/documents/relations/$(rid)).data.a, get(/databases/$(database)/documents/relations/$(rid)).data.b]
          && me() in get(/databases/$(database)/documents/clans/$(request.resource.data.clan)).data.members;
        allow delete: if signed() && (resource.data.uid == me()
          || clanOwner(get(/databases/$(database)/documents/relations/$(rid)).data.a) == me()
          || clanOwner(get(/databases/$(database)/documents/relations/$(rid)).data.b) == me());
      }
    }

    // clanrels/{cid}: relaciones activas de un clan (allies y rivals, máximo 5 de cada). Cada escritura cambia un solo clan («last»)
    // y tiene que cuadrar con relations: se añade si la relación queda activa y se quita si la relación ya no existe.
    function oldLinks(f) { return resource == null ? [] : resource.data.get(f, []); }
    function onlyLast(f) {
      let n = request.resource.data.get(f, []).toSet();
      let o = oldLinks(f).toSet();
      return n.difference(o).hasOnly([request.resource.data.last]) && o.difference(n).hasOnly([request.resource.data.last]);
    }
    function linkOk(cid, f, t) {
      let x = request.resource.data.last;
      let added = (x in request.resource.data.get(f, [])) && !(x in oldLinks(f));
      let removed = !(x in request.resource.data.get(f, [])) && (x in oldLinks(f));
      let rel = /databases/$(database)/documents/relations/$(pairId(cid, x));
      return (!added || (existsAfter(rel) && getAfter(rel).data.status == 'activa' && getAfter(rel).data.type == t))
        && (!removed || !existsAfter(rel));
    }
    match /clanrels/{cid} {
      allow read: if signed();
      allow create, update: if signed()
        && request.resource.data.keys().hasOnly(['allies', 'rivals', 'last'])
        && request.resource.data.last is string
        && request.resource.data.get('allies', []) is list && request.resource.data.get('allies', []).size() <= 5
        && request.resource.data.get('rivals', []) is list && request.resource.data.get('rivals', []).size() <= 5
        && (clanOwner(cid) == me() || clanOwner(request.resource.data.last) == me())
        && onlyLast('allies') && onlyLast('rivals')
        && linkOk(cid, 'allies', 'alianza') && linkOk(cid, 'rivals', 'pique');
      allow delete: if signed() && clanOwner(cid) == me();
    }
  }
}
